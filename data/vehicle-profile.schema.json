{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trucksil.invalid/schemas/vehicle-profile.schema.json",
  "title": "TrucksIL vehicle profile (draft)",
  "description": "Dimensions and weights of a vehicle used for route checks. Bounds are sanity limits, not legal limits.",
  "type": "object",
  "required": ["profileName", "heightM", "widthM", "lengthM", "grossWeightT"],
  "properties": {
    "profileName": {"type": "string", "minLength": 1, "maxLength": 120},
    "heightM": {"type": "number", "minimum": 1.0, "maximum": 6.0},
    "widthM": {"type": "number", "minimum": 1.0, "maximum": 6.0},
    "lengthM": {"type": "number", "minimum": 2.0, "maximum": 60.0},
    "grossWeightT": {"type": "number", "minimum": 0.5, "maximum": 200.0},
    "axleLoadT": {"type": "number", "minimum": 0.5, "maximum": 40.0},
    "hazmat": {
      "type": "object",
      "description": "Dangerous goods carried, by ADR class (1-9).",
      "required": ["adrClasses"],
      "properties": {
        "adrClasses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["1", "2", "3", "4.1", "4.2", "4.3", "5.1", "5.2", "6.1", "6.2", "7", "8", "9"]}}
      },
      "additionalProperties": false
    },
    "note": {"type": "string"}
  },
  "additionalProperties": false
}
