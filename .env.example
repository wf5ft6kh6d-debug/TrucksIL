# Copy to .env and change the password. .env is git-ignored.
POSTGRES_DB=trucksil
POSTGRES_USER=trucksil
POSTGRES_PASSWORD=change-me-local-only
DB_PORT=5432
API_PORT=8080
VALHALLA_PORT=8002
WEB_PORT=8081
# Unset (default) -> the api uses http://valhalla:8002, the compose `valhalla` service started with
# `docker compose --profile routing up`. Without that profile /health shows "valhalla":"down".
# To run without routing on purpose ("valhalla":"disabled", POST /v1/route -> 503), uncomment:
# VALHALLA_URL=

# Driver reports (ADR-0012). Salt for hashing anonymous client ids; empty -> dev salt (warning in log).
# Generate: openssl rand -hex 32
REPORTS_SALT=
# Token for POST /v1/reports/:id/moderate (header x-moderator-token). Empty -> moderation disabled (403).
MODERATOR_TOKEN=
