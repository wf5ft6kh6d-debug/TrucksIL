# Copy to .env and change the password. .env is git-ignored.
POSTGRES_DB=trucksil
POSTGRES_USER=trucksil
POSTGRES_PASSWORD=change-me-local-only
DB_PORT=5432
API_PORT=8080
VALHALLA_PORT=8002
# Leave empty to run without routing (POST /v1/route returns 503).
# With `docker compose --profile routing up` set:
# VALHALLA_URL=http://valhalla:8002
VALHALLA_URL=
